{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Shuboya1030/partimephd/blob/main/research/study2/study2_1_run_metadata_schema.json",
  "title": "Study 2.1 episode run metadata",
  "description": "One record per model-task-condition-replicate episode. Never include API keys or authorization headers.",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "study_id",
    "run_type",
    "collection_stage",
    "protocol_version",
    "task_id",
    "task_version",
    "template_id",
    "help_need_class",
    "variant_id",
    "model_provider",
    "model_requested",
    "model_returned",
    "endpoint",
    "profile_condition",
    "instance_seed",
    "replicate",
    "candidate_order",
    "alignment",
    "mapping_ref",
    "mapping_hash",
    "sampling_parameters",
    "prompt_hashes",
    "task_hashes",
    "runtime_version",
    "npc_policy_version",
    "evaluator_version",
    "adapter_name",
    "adapter_version",
    "started_at",
    "ended_at",
    "status",
    "api_request_ids",
    "retries",
    "errors",
    "agent_tokens",
    "npc_tokens_or_unavailable",
    "estimated_cost_usd",
    "cost_status",
    "latency_ms",
    "checkpoint_vector",
    "artifact_refs",
    "retry_of",
    "exclusion_reason"
  ],
  "properties": {
    "schema_version": {"const": "study21-run-v2"},
    "run_id": {"type": "string", "minLength": 1},
    "study_id": {"const": "study2.1"},
    "run_type": {"enum": ["pilot", "confirmatory"]},
    "collection_stage": {"enum": ["pilot", "R1", "R0"]},
    "protocol_version": {"type": "string"},
    "task_id": {"type": "string"},
    "task_version": {"type": "string"},
    "template_id": {"type": "string"},
    "help_need_class": {"enum": ["must_ask", "optional_benefit", "no_help"]},
    "variant_id": {"type": ["string", "null"]},
    "alignment": {"enum": ["aligned", "separated", "not_applicable"]},
    "model_provider": {"enum": ["OpenAI", "Moonshot", "Anthropic"]},
    "model_requested": {"type": "string"},
    "model_returned": {"type": ["string", "null"]},
    "endpoint": {"type": "string", "description": "Base/API endpoint only; exclude credentials and authorization headers."},
    "api_request_ids": {"type": "array", "items": {"type": "string"}},
    "adapter_name": {"type": "string"},
    "adapter_version": {"type": "string"},
    "profile_condition": {"enum": ["R0", "R1"]},
    "instance_seed": {"type": ["integer", "string"]},
    "replicate": {"type": "integer", "minimum": 1},
    "candidate_order": {"type": "array", "items": {"type": "string"}},
    "mapping_ref": {"type": "string"},
    "mapping_hash": {"type": "string"},
    "sampling_parameters": {"type": "object"},
    "prompt_hashes": {
      "type": "object",
      "required": ["system", "task", "tool_schema"],
      "properties": {
        "system": {"type": "string"},
        "task": {"type": "string"},
        "tool_schema": {"type": "string"}
      },
      "additionalProperties": true
    },
    "task_hashes": {
      "type": "object",
      "required": ["task", "gold", "scenario", "evaluator"],
      "properties": {
        "task": {"type": "string"},
        "gold": {"type": "string"},
        "scenario": {"type": "string"},
        "evaluator": {"type": "string"}
      },
      "additionalProperties": true
    },
    "runtime_version": {"type": "string"},
    "npc_policy_version": {"type": "string"},
    "evaluator_version": {"type": "string"},
    "started_at": {"type": "string", "format": "date-time"},
    "ended_at": {"type": ["string", "null"], "format": "date-time"},
    "status": {"enum": ["started", "completed", "failed", "invalid"]},
    "retries": {"type": "array", "items": {"type": "object"}},
    "errors": {"type": "array", "items": {"type": "object"}},
    "agent_tokens": {
      "type": "object",
      "required": ["input", "output", "cached_input"],
      "properties": {
        "input": {"type": ["integer", "null"], "minimum": 0},
        "output": {"type": ["integer", "null"], "minimum": 0},
        "cached_input": {"type": ["integer", "null", "string"]}
      },
      "additionalProperties": true
    },
    "npc_tokens_or_unavailable": {"type": ["object", "integer", "string", "null"]},
    "estimated_cost_usd": {"type": ["number", "null"], "minimum": 0},
    "cost_status": {"enum": ["actual", "estimated", "unavailable"]},
    "pricing_snapshot": {"type": ["object", "null"]},
    "latency_ms": {"type": ["number", "null"], "minimum": 0},
    "checkpoint_vector": {"type": "object"},
    "behavior_metrics": {"type": ["object", "null"]},
    "artifact_refs": {"type": "object"},
    "retry_of": {"type": ["string", "null"]},
    "supersedes": {"type": ["string", "null"]},
    "exclusion_reason": {"type": ["string", "null"]}
  },
  "additionalProperties": false
}
