{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Study2 task metadata v2 (structural contract only)",
  "type": "object",
  "required": [
    "task_id",
    "version",
    "help_class",
    "target_level",
    "domain",
    "N",
    "feature_scores",
    "difficulty_score",
    "dependency_depth",
    "instance_seed",
    "candidate_pool",
    "workflow_id",
    "workflow_pair_id",
    "source_spec",
    "output_contract",
    "runtime_classification_status",
    "feature_names",
    "separation",
    "structure",
    "cue",
    "quality",
    "inference_evidence",
    "candidate_pool_semantics",
    "profile_conditions",
    "default_profile",
    "hidden_information_ids",
    "gold_dag",
    "services",
    "npc_backend",
    "runtime",
    "verification",
    "known_limitations"
  ],
  "properties": {
    "task_id": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "help_class": {
      "enum": [
        "Must-help",
        "Optional-help"
      ]
    },
    "target_level": {
      "enum": [
        "Low",
        "Medium",
        "High"
      ]
    },
    "domain": {
      "type": "string"
    },
    "N": {
      "enum": [
        4,
        8,
        16
      ]
    },
    "feature_scores": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 2
      }
    },
    "difficulty_score": {
      "type": "integer",
      "minimum": 0,
      "maximum": 8
    },
    "dependency_depth": {
      "type": "integer"
    },
    "instance_seed": {
      "type": "integer"
    },
    "candidate_pool": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "workflow_id": {
      "type": "string"
    },
    "workflow_pair_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_spec": {
      "type": "object"
    },
    "output_contract": {
      "type": "object"
    },
    "runtime_classification_status": {
      "type": "string"
    },
    "feature_names": {
      "type": "array"
    },
    "separation": {
      "type": "string"
    },
    "structure": {
      "type": "string"
    },
    "cue": {
      "type": [
        "object",
        "null"
      ]
    },
    "quality": {
      "type": [
        "object",
        "null"
      ]
    },
    "inference_evidence": {
      "type": "array"
    },
    "candidate_pool_semantics": {
      "type": "string"
    },
    "profile_conditions": {
      "type": "array"
    },
    "default_profile": {
      "type": "string"
    },
    "hidden_information_ids": {
      "type": "array"
    },
    "gold_dag": {
      "type": "object"
    },
    "services": {
      "type": "array"
    },
    "npc_backend": {
      "type": "string"
    },
    "runtime": {
      "type": "object"
    },
    "verification": {
      "type": "object"
    },
    "known_limitations": {
      "type": "array"
    }
  }
}
